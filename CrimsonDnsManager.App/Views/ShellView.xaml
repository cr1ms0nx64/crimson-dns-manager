<UserControl
    x:Class="CrimsonDnsManager.App.Views.ShellView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CrimsonDnsManager.App.Views"
    xmlns:controls="using:CrimsonDnsManager.App.Controls"
    xmlns:converters="using:CrimsonDnsManager.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:ZoneItemBrushConverter x:Key="ZoneItemBrush" />
        <Style x:Key="SidebarTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CrimsonTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SoraFont}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="SidebarPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource CrimsonPasswordBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource SoraFont}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Ellipse Width="680" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-190,0,0" Opacity="0.22" Fill="#1A28A0FF" />
        <Ellipse Width="520" Height="320" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-160,0" Opacity="0.14" Fill="#193C50FF" />

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Height="52"
                Background="{StaticResource TopbarBackgroundBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Padding="24,0,140,0" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" BorderBrush="#4740C8F4" BorderThickness="1" Background="#3828A0FF">
                        <Image Source="ms-appx:///Assets/Images/favicon-128-removebg-preview.png" Stretch="Uniform" Margin="2" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Images/crimson-wordmark.png" Height="28" Width="118" Stretch="Uniform" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DNS MANAGER" FontFamily="{StaticResource MonoMediumFont}" FontSize="9" CharacterSpacing="140" Foreground="{StaticResource SoftBrush}" />
                            <TextBlock Text="{Binding VersionText}" FontFamily="{StaticResource MonoFont}" FontSize="9" CharacterSpacing="80" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="TitleBarDragArea"
                        x:FieldModifier="public"
                        Grid.Column="1"
                        Background="Transparent" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CrimsonDangerButtonStyle}"
                            Command="{Binding DnsRecords.OpenDeleteModalCommand}"
                            Visibility="{Binding DnsRecords.HasSelection, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="✕" FontFamily="{StaticResource MonoSemiBoldFont}" FontSize="14" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Auswahl löschen" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
                            <Border CornerRadius="8" Background="#40F45060" Padding="6,1" Margin="2,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DnsRecords.SelectedCount}" FontFamily="{StaticResource MonoSemiBoldFont}" FontSize="10" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CrimsonWarnButtonStyle}" Command="{Binding DnsRecords.OpenAddRecordCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="＋" FontFamily="{StaticResource MonoSemiBoldFont}" FontSize="14" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Record hinzufügen" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CrimsonPrimaryButtonStyle}" Command="{Binding DnsRecords.SaveDnsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="↑" FontFamily="{StaticResource MonoSemiBoldFont}" FontSize="14" Foreground="{StaticResource Cyan2Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="DNS speichern" Foreground="{StaticResource Cyan2Brush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FA050912" Offset="0" />
                    <GradientStop Color="#F0070C18" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                <StackPanel>
                    <StackPanel Padding="16,18,16,12" Spacing="7">
                        <TextBlock Text="Cloudflare API" Style="{StaticResource SidebarLabelTextStyle}" Margin="0,0,0,3" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="API Token" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="ApiTokenBox" Style="{StaticResource SidebarPasswordBoxStyle}" PasswordChanged="ApiTokenBox_OnPasswordChanged" GotFocus="ApiTokenBox_OnGotFocus" PlaceholderText="Cloudflare Token" CharacterSpacing="180" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Domain" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Style="{StaticResource SidebarTextBoxStyle}" Text="{Binding Settings.Domain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Zone ID" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox Style="{StaticResource SidebarTextBoxStyle}" Text="{Binding Settings.ZoneId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="10" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}">
                                <Run Text="Account ID" />
                                <Run Text=" (optional)" Foreground="{StaticResource MutedBrush}" />
                            </TextBlock>
                            <TextBox Style="{StaticResource SidebarTextBoxStyle}" Text="{Binding Settings.AccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="10" />
                        </StackPanel>

                        <CheckBox Content="Backup vor DNS speichern" IsChecked="{Binding Settings.BackupBeforeSave, Mode=TwoWay}" Style="{StaticResource CrimsonCheckBoxStyle}" />
                        <CheckBox Content="Web Records standardmäßig proxied" IsChecked="{Binding Settings.DefaultWebRecordsProxied, Mode=TwoWay}" Style="{StaticResource CrimsonCheckBoxStyle}" />

                        <Grid ColumnSpacing="6" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Speichern" Style="{StaticResource CrimsonSidebarButtonStyle}" Command="{Binding Settings.SaveCommand}" />
                            <Button Grid.Column="1" Content="Verbindung testen" Style="{StaticResource CrimsonSidebarActionButtonStyle}" Command="{Binding Settings.TestConnectionCommand}" />
                        </Grid>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
                    <StackPanel Padding="16,18,16,12" Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cloudflare Zonen" Style="{StaticResource SidebarLabelTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource CrimsonSidebarSmallButtonStyle}" Command="{Binding Settings.LoadZonesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="↺" FontFamily="{StaticResource MonoSemiBoldFont}" FontSize="10" Foreground="{StaticResource SoftBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Laden" Foreground="{StaticResource SoftBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Settings.Zones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.Settings.SelectZoneCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource CrimsonZoneButtonStyle}"
                                            Background="{Binding IsActive, Converter={StaticResource ZoneItemBrush}, ConverterParameter=Background}"
                                            BorderBrush="{Binding IsActive, Converter={StaticResource ZoneItemBrush}, ConverterParameter=Border}"
                                            Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource SoraSemiBoldFont}"
                                                       FontSize="11.5"
                                                       Foreground="{Binding IsActive, Converter={StaticResource ZoneItemBrush}, ConverterParameter=Foreground}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Width="12" Height="12" Visibility="{Binding IsActive, Converter={StaticResource VisibleWhenTrue}}" VerticalAlignment="Center">
                                                <Ellipse Width="12" Height="12" Fill="#2634D48A" />
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
                    <StackPanel Padding="16,18,16,12" Spacing="10">
                        <TextBlock Text="Zone Schnellzugriff" Style="{StaticResource SidebarLabelTextStyle}" />
                        <Grid ColumnSpacing="6" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="54" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CrimsonQuickButtonStyle}" Command="{Binding DnsRecords.LoadRecordsCommand}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontFamily="Segoe UI Emoji" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Text="DNS Records" FontFamily="{StaticResource SoraMediumFont}" FontSize="11" Foreground="{StaticResource SoftBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CrimsonQuickButtonStyle}" Command="{Binding Settings.CopyZoneIdCommand}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⎘" FontFamily="{StaticResource MonoSemiBoldFont}" FontSize="15" Foreground="{StaticResource SoftBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Zone ID kopieren" FontFamily="{StaticResource SoraMediumFont}" FontSize="11" Foreground="{StaticResource SoftBrush}" TextAlignment="Center" TextWrapping="NoWrap" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CrimsonQuickButtonStyle}" Command="{Binding Settings.OpenDashboardCommand}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="↗" FontFamily="{StaticResource MonoSemiBoldFont}" FontSize="15" Foreground="{StaticResource SoftBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="CF Dashboard" FontFamily="{StaticResource SoraMediumFont}" FontSize="11" Foreground="{StaticResource SoftBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CrimsonQuickButtonStyle}" Command="{Binding Settings.OpenBackupFolderCommand}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontFamily="Segoe UI Emoji" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Text="Backup Ordner" FontFamily="{StaticResource SoraMediumFont}" FontSize="11" Foreground="{StaticResource SoftBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
                    <StackPanel Padding="16,18,16,12" Spacing="10">
                        <TextBlock Text="App Update" Style="{StaticResource SidebarLabelTextStyle}" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="13,12">
                            <StackPanel Spacing="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Paket Update" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
                                    <controls:StatusBadge Grid.Column="1" Text="{Binding Update.BadgeText}" Variant="gray" />
                                </Grid>
                                <TextBlock Text="{Binding Update.StatusText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" />
                                <StackPanel Spacing="5">
                                    <Button Content="Paket wählen" Style="{StaticResource CrimsonGhostButtonStyle}" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding Update.PickPackageCommand}" />
                                    <Button Content="Prüfen" Style="{StaticResource CrimsonGhostButtonStyle}" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding Update.VerifyPackageCommand}" />
                                    <Button Style="{StaticResource CrimsonPrimaryButtonStyle}" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding Update.InstallAndRestartCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="⟳" FontFamily="{StaticResource MonoSemiBoldFont}" FontSize="11" Foreground="{StaticResource Cyan2Brush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Installieren &amp; neu starten" Foreground="{StaticResource Cyan2Brush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <views:DnsRecordsView Grid.Row="1" Grid.Column="1" DataContext="{Binding DnsRecords}" />
    </Grid>
</UserControl>
