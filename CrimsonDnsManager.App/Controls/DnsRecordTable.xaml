<UserControl
    x:Class="CrimsonDnsManager.App.Controls.DnsRecordTable"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CrimsonDnsManager.App.Controls">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                x:Name="SelectionBar"
                Visibility="Collapsed"
                Margin="0,10,0,0"
                Padding="14,9"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="#47F45060"
                Background="#12F45060">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelCountText"
                           FontFamily="{StaticResource MonoSemiBoldFont}"
                           FontSize="11"
                           Foreground="{StaticResource RedBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Records zum Löschen markiert"
                           FontSize="12"
                           Foreground="{StaticResource SoftBrush}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="Auswahl aufheben"
                        Click="ClearSelection_Click"
                        Style="{StaticResource CrimsonGhostButtonStyle}"
                        FontSize="11"
                        MinHeight="28"
                        Padding="10,4" />
                <Button Grid.Column="3"
                        Click="DeleteSelected_Click"
                        Style="{StaticResource CrimsonDangerButtonStyle}"
                        FontSize="11"
                        MinHeight="28"
                        Padding="12,4"
                        Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="✕"
                                   FontFamily="{StaticResource MonoSemiBoldFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource RedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Löschen"
                                   Foreground="{StaticResource RedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              MinHeight="280"
              Margin="0,14,0,0">
            <ListView x:Name="RecordsList"
                      ItemsSource="{Binding Records, ElementName=Root}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      ItemContainerStyle="{StaticResource CrimsonTableListViewItemStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.Header>
                    <Grid Padding="0,0,0,9"
                          BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  x:Name="HeaderCheckBox"
                                  IsThreeState="True"
                                  Checked="HeaderCheckBox_Checked"
                                  Unchecked="HeaderCheckBox_Unchecked"
                                  Indeterminate="HeaderCheckBox_Indeterminate"
                                  Style="{StaticResource CrimsonHeaderCheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="TYP" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="CONTENT" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="4" Text="TTL" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="PRIO" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="PROXY" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="AKTIONEN" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <controls:DnsRecordRow Record="{Binding}"
                                               EditRequested="Row_EditRequested"
                                               DeleteRequested="Row_DeleteRequested"
                                               SelectionChanged="Row_SelectionChanged" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="EmptyState"
                    Visibility="Collapsed"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Keine DNS Records geladen"
                               FontFamily="{StaticResource SoraSemiBoldFont}"
                               FontSize="16"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Wähle eine Zone und lade die Records über den Schnellzugriff oder die Zonenliste."
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center" />
                    <Button Content="DNS Records laden"
                            Style="{StaticResource CrimsonPrimaryButtonStyle}"
                            Click="LoadRecords_Click"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
