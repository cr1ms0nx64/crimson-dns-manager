<UserControl
    x:Class="CrimsonDnsManager.App.Controls.DeleteConfirmDialog"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CrimsonDnsManager.App.Converters">

    <UserControl.Resources>
        <converters:RecordTypeBrushConverter x:Key="RecordTypeBrush" />
    </UserControl.Resources>

    <Border Width="500"
            MaxWidth="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="#4DF45060"
            BorderThickness="1"
            CornerRadius="22"
            Background="#FF14060A"
            Padding="22">
        <StackPanel Spacing="0">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,5">
                <TextBlock Text="⚠"
                           FontFamily="{StaticResource MonoSemiBoldFont}"
                           FontSize="9"
                           Foreground="{StaticResource RedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="LÖSCHEN BESTÄTIGEN"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="9"
                           CharacterSpacing="160"
                           Foreground="{StaticResource RedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Records entfernen"
                       FontFamily="{StaticResource SoraBoldFont}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Die folgenden Records werden dauerhaft aus Cloudflare gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"
                       FontFamily="{StaticResource SoraFont}"
                       FontSize="12"
                       LineHeight="18.5"
                       Margin="0,0,0,14" />

            <ScrollViewer MaxHeight="220"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,14">
                <ItemsControl ItemsSource="{Binding Records, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#26F45060"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="11,8"
                                    Background="#0DF45060"
                                    Margin="0,0,0,5">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontFamily="{StaticResource MonoSemiBoldFont}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Type}"
                                               FontFamily="{StaticResource MonoSemiBoldFont}"
                                               FontSize="10"
                                               Foreground="{Binding Type, Converter={StaticResource RecordTypeBrush}}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Content}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border BorderBrush="#33F4C040"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="11,9"
                    Background="#0DF4C040"
                    Margin="0,0,0,14">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="⚠"
                               FontFamily="{StaticResource SoraSemiBoldFont}"
                               FontSize="11.5"
                               Foreground="{StaticResource AmberBrush}"
                               VerticalAlignment="Top"
                               Margin="0,1,0,0" />
                    <RichTextBlock Grid.Column="1"
                                   FontFamily="{StaticResource SoraSemiBoldFont}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource AmberBrush}"
                                   LineHeight="16"
                                   TextWrapping="Wrap">
                        <Paragraph>
                            <Run Text="Cloudflare API: Pro Record ein " />
                            <InlineUIContainer>
                                <Border CornerRadius="4"
                                        Background="#1FF4C040"
                                        Padding="4,0"
                                        Margin="2,0,2,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="DELETE"
                                               FontFamily="{StaticResource MonoSemiBoldFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource AmberBrush}" />
                                </Border>
                            </InlineUIContainer>
                            <Run Text="-Request. Änderungen sind sofort live." />
                        </Paragraph>
                    </RichTextBlock>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal"
                        Spacing="7"
                        HorizontalAlignment="Right">
                <Button Content="Abbrechen"
                        Style="{StaticResource CrimsonGhostButtonStyle}"
                        Command="{Binding CancelCommand, ElementName=Root}" />
                <Button Style="{StaticResource CrimsonDangerButtonStyle}"
                        Command="{Binding ConfirmCommand, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="✕"
                                   FontFamily="{StaticResource MonoSemiBoldFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource RedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Jetzt löschen"
                                   Foreground="{StaticResource RedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
