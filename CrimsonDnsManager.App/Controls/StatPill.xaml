<UserControl
    x:Class="CrimsonDnsManager.App.Controls.StatPill"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="999"
            Background="{StaticResource PillBackgroundBrush}"
            BorderBrush="{StaticResource PillBorderBrush}"
            BorderThickness="1"
            Padding="13,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Grid x:Name="DotContainer"
                  Width="10"
                  Height="10"
                  Visibility="Collapsed"
                  VerticalAlignment="Center">
                <Ellipse x:Name="DotGlow" Width="10" Height="10" Opacity="0.25" />
                <Ellipse x:Name="StatusDot" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{x:Bind Value, Mode=OneWay}"
                       FontFamily="{StaticResource MonoSemiBoldFont}"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Label, Mode=OneWay}"
                       FontFamily="{StaticResource SoraFont}"
                       FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
