<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="SoraFont">ms-appx:///Assets/Fonts/Sora-Regular.ttf#Sora</FontFamily>
    <FontFamily x:Key="SoraMediumFont">ms-appx:///Assets/Fonts/Sora-Medium.ttf#Sora Medium</FontFamily>
    <FontFamily x:Key="SoraSemiBoldFont">ms-appx:///Assets/Fonts/Sora-SemiBold.ttf#Sora SemiBold</FontFamily>
    <FontFamily x:Key="SoraBoldFont">ms-appx:///Assets/Fonts/Sora-Bold.ttf#Sora</FontFamily>
    <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono</FontFamily>
    <FontFamily x:Key="MonoMediumFont">ms-appx:///Assets/Fonts/IBMPlexMono-Medium.ttf#IBM Plex Mono Medium</FontFamily>
    <FontFamily x:Key="MonoSemiBoldFont">ms-appx:///Assets/Fonts/IBMPlexMono-SemiBold.ttf#IBM Plex Mono SemiBold</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SoraFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="KickerTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    </Style>

    <Style x:Key="SidebarLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{StaticResource SidebarLabelBrush}" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SoraFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelTextStyle}" />

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SoraBoldFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SoraFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="MonoValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource SoftBrush}" />
    </Style>

</ResourceDictionary>
