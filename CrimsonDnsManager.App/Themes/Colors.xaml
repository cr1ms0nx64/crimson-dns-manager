<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorBg">#FF05080F</Color>
    <Color x:Key="ColorBg2">#FF080D18</Color>
    <Color x:Key="ColorSurface">#E60B1224</Color>
    <Color x:Key="ColorSurface2">#B3101A32</Color>
    <Color x:Key="ColorLine">#14789AC8</Color>
    <Color x:Key="ColorLine2">#2E789AC8</Color>
    <Color x:Key="ColorText">#FFDDEEFF</Color>
    <Color x:Key="ColorMuted">#FF5A7A96</Color>
    <Color x:Key="ColorSoft">#FF9AB8CC</Color>
    <Color x:Key="ColorCyan">#FF40C8F4</Color>
    <Color x:Key="ColorCyan2">#FF78DCFF</Color>
    <Color x:Key="ColorGreen">#FF34D48A</Color>
    <Color x:Key="ColorAmber">#FFF4C040</Color>
    <Color x:Key="ColorRed">#FFF45060</Color>
    <Color x:Key="ColorSidebarLabel">#FF3A5268</Color>
    <Color x:Key="ColorTypeMX">#FFA78BFA</Color>
    <Color x:Key="ColorTypeSRV">#FFFB923C</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource ColorBg2}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource ColorSurface2}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource ColorLine}" />
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource ColorLine2}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="SoftBrush" Color="{StaticResource ColorSoft}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ColorCyan}" />
    <SolidColorBrush x:Key="Cyan2Brush" Color="{StaticResource ColorCyan2}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource ColorAmber}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource ColorRed}" />
    <SolidColorBrush x:Key="SidebarLabelBrush" Color="{StaticResource ColorSidebarLabel}" />
    <SolidColorBrush x:Key="TypeMxBrush" Color="{StaticResource ColorTypeMX}" />
    <SolidColorBrush x:Key="TypeSrvBrush" Color="{StaticResource ColorTypeSRV}" />

    <SolidColorBrush x:Key="TopbarBackgroundBrush" Color="#F205080F" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#B3020610" />
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#6140C8F4" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1240C8F4" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2140C8F4" />
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#0F40C8F4" />
    <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#14F4C040" />
    <SolidColorBrush x:Key="WarnHoverBrush" Color="#24F4C040" />
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#47F4C040" />
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#14F45060" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#24F45060" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#47F45060" />
    <SolidColorBrush x:Key="WhiteSoftLayerBrush" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#06FFFFFF" />
    <SolidColorBrush x:Key="PillBorderBrush" Color="#14789AC8" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#05FFFFFF" />
    <SolidColorBrush x:Key="LivefeedBackgroundBrush" Color="#BF020610" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#0D40C8F4" />
    <SolidColorBrush x:Key="TableRowLineBrush" Color="#0D78C8FF" />
    <SolidColorBrush x:Key="TableRowSelectedBrush" Color="#0FF45060" />
    <SolidColorBrush x:Key="TableRowSelectedHoverBrush" Color="#17F45060" />
    <SolidColorBrush x:Key="TableRowHoverRailBrush" Color="#8040C8F4" />
    <SolidColorBrush x:Key="TableRowSelectedRailBrush" Color="#99F45060" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#12F45060" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#99F45060" />
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#B3000000" />
    <AcrylicBrush x:Key="ModalBackdropBrush"
                  TintColor="#05080F"
                  TintOpacity="0.78"
                  TintLuminosityOpacity="0.18"
                  FallbackColor="#D9000000" />
    <SolidColorBrush x:Key="DimTimestampBrush" Color="#334455" />
</ResourceDictionary>
